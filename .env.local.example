# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Génération ────────────────────────────────────────────────────────────────
# Option A — Groq (gratuit, sans CB) : console.groq.com
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# Option B — Google AI Studio : aistudio.google.com/app/apikey
# GOOGLE_GENERATIVE_AI_API_KEY=AIza...
# GENERATION_MODEL=gemini-2.0-flash

# ── Embeddings ────────────────────────────────────────────────────────────────
# OpenAI text-embedding-3-large (3072 dims)
# Doit correspondre au modèle configuré dans n8n pour l'ingestion
OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=3072

# ── Supabase config ───────────────────────────────────────────────────────────
SUPABASE_DOCUMENTS_TABLE=chunks
SUPABASE_MATCH_FUNCTION=match_chunks
