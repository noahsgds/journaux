# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google AI Studio — une seule clé pour embeddings + génération
# Obtenir sur : https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=AIza...

# Supabase config (à ajuster selon ton schéma)
SUPABASE_DOCUMENTS_TABLE=chunks
SUPABASE_MATCH_FUNCTION=match_chunks

# Modèle d'embedding Google (gemini-embedding-2 = 3072 dims — doit correspondre au pipeline n8n)
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=3072

# Modèle de génération Google
# Options : gemini-2.0-flash | gemini-1.5-pro | gemini-2.5-pro-preview-05-06
GENERATION_MODEL=gemini-2.0-flash
