# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Génération ────────────────────────────────────────────────────────────────
# Option A — Groq (gratuit, sans CB) : console.groq.com
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile   # ou llama-3.1-8b-instant pour plus de rapidité

# Option B — Google AI Studio : aistudio.google.com/app/apikey
# (désactiver si GROQ_API_KEY est défini — Groq est prioritaire)
# GOOGLE_GENERATIVE_AI_API_KEY=AIza...
# GENERATION_MODEL=gemini-2.0-flash

# ── Embeddings (doit correspondre au modèle n8n) ──────────────────────────────
# Google reste nécessaire pour les embeddings même si Groq gère la génération
GOOGLE_GENERATIVE_AI_API_KEY=AIza...
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=3072

# ── Supabase config ───────────────────────────────────────────────────────────
SUPABASE_DOCUMENTS_TABLE=chunks
SUPABASE_MATCH_FUNCTION=match_chunks
